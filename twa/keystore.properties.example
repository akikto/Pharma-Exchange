# Copy to keystore.properties (gitignored) and fill with your upload keystore values.
# Do NOT commit keystore.properties or release.keystore.
#
# After creating the keystore:
#   keytool -genkey -v -keystore release.keystore -alias pharmex-release -keyalg RSA -keysize 2048 -validity 10000
#
# Get SHA-256 for Digital Asset Links:
#   keytool -list -v -keystore release.keystore -alias pharmex-release
#
storeFile=../release.keystore
storePassword=REPLACE_ME
keyPassword=REPLACE_ME
keyAlias=pharmex-release
