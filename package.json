{
  "name": "pharma-exchange",
  "version": "1.0.0",
  "private": true,
  "description": "PharmEx — B2B pharmacy marketplace for Bangladesh",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:all": "npm run dev --workspace=backend & npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:push": "npm run db:push --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "test": "npm run test --workspaces --if-present",
    "test:backend": "npm run test --workspace=backend",
    "test:frontend": "npm run test --workspace=frontend",
    "smoke": "bash scripts/smoke-test.sh",
    "lint": "npm run lint --workspaces --if-present",
    "audit:ci": "node scripts/audit-ci.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "teeny-request": {
      "uuid": "^11.1.1"
    },
    "smol-toml": "1.6.1",
    "js-yaml": "^4.2.1",
    "minimatch": "^10.2.3",
    "@vercel/node": {
      "@vercel/python-analysis": {
        "smol-toml": "1.6.1",
        "js-yaml": "^4.2.1",
        "minimatch": "^10.2.3"
      }
    },
    "@vercel/python-analysis": {
      "smol-toml": "1.6.1",
      "js-yaml": "^4.2.1",
      "minimatch": "^10.2.3"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
