# =============================================================================
# Pharma-Exchange Frontend — Production Environment (Example)
# =============================================================================
# Set these in Vercel → frontend project → Settings → Environment Variables.
# NEVER commit real values. See frontend/.env.example for full documentation.
#
# VITE_* variables are public — embedded in the browser bundle at build time.
# =============================================================================

VITE_API_BASE_URL=https://pharma-exchange-backend.vercel.app/api/v1
VITE_SOCKET_URL=https://pharma-exchange-backend.vercel.app

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
