# Vercel Production Environment Variables (Frontend)
#
# Set these on Vercel Project → Settings → Environment Variables.
# NEVER commit real values.
#
# Only variables prefixed with `VITE_` are exposed to the browser bundle —
# treat them as public. Do NOT put secrets (service accounts, private keys,
# admin tokens) into any VITE_* variable.

# API base — the Vercel-provided URL of the backend project.
VITE_API_BASE_URL=/api/v1

# Optional Socket.IO base — set only if realtime is enabled.
VITE_SOCKET_URL=

# ─── Firebase Web SDK (public keys — safe to expose) ───────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# VAPID key for FCM Web push (public key from Firebase Console → Cloud Messaging)
VITE_FIREBASE_VAPID_KEY=
