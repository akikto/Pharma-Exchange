# =============================================================================
# Pharma-Exchange Frontend — Environment Variables (Example)
# =============================================================================
# Copy to frontend/.env for local Vite dev server.
# On Vercel: set in Project → Settings → Environment Variables (Production + Preview).
#
# Only variables prefixed with VITE_ are embedded in the client bundle at build time.
# They are PUBLIC — never put server secrets, private keys, or admin tokens here.
#
# Used by: frontend/src/lib/api.ts, socket.ts, firebase.ts, push-notifications.ts
# =============================================================================


# -----------------------------------------------------------------------------
# API & realtime
# -----------------------------------------------------------------------------

# Required — backend API base URL
# Local dev: /api/v1 (proxied to localhost:3000 by vite.config.ts)
# Vercel prod: full URL e.g. https://pharma-exchange-backend.vercel.app/api/v1
# Source: your backend deployment URL + /api/v1
VITE_API_BASE_URL=/api/v1

# Optional — legacy alias for VITE_API_BASE_URL (either may be set; base URL wins)
# Source: same as VITE_API_BASE_URL
VITE_API_URL=

# Optional — Socket.IO server origin for realtime chat/notifications
# Empty string = same origin as the page (recommended when API and frontend share a domain)
# Source: backend URL without /api/v1 path, e.g. https://pharma-exchange-backend.vercel.app
VITE_SOCKET_URL=


# -----------------------------------------------------------------------------
# Firebase Web SDK — optional in dev; required for Google sign-in and web push
# Source: Firebase Console → Project settings → Your apps → Web app → SDK config
# These values are designed to be public in client apps
# -----------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=


# -----------------------------------------------------------------------------
# FCM Web Push — optional; required to register browser push tokens
# Source: Firebase Console → Project settings → Cloud Messaging → Web Push certificates → Key pair
# -----------------------------------------------------------------------------

VITE_FIREBASE_VAPID_KEY=


# -----------------------------------------------------------------------------
# Docker build args only (frontend/Dockerfile) — not read at runtime by Vite in dev
# -----------------------------------------------------------------------------

# VITE_APP_NAME=Pharma-Exchange
