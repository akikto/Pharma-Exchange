{
  "version": 2,
  "installCommand": "cd .. && npm ci --include=dev",
  "buildCommand": "npm run vercel-build",
  "redirects": [
    {
      "source": "/",
      "destination": "/api",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "../node_modules/.prisma/**"
    }
  }
}
