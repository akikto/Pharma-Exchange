{
  "version": 2,
  "installCommand": "cd .. && npm ci --include=dev",
  "buildCommand": "npx prisma generate",
  "rewrites": [
    { "source": "/health", "destination": "/api/ping" },
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "../node_modules/.prisma/**"
    },
    "api/ping.ts": {
      "maxDuration": 10,
      "memory": 256
    }
  }
}
