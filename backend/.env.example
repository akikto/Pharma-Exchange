# =============================================================================
# Pharma-Exchange Backend — Environment Variables (Example)
# =============================================================================
# Copy to backend/.env for local development and Prisma CLI.
# On Vercel: set these in Project → Settings → Environment Variables.
# NEVER commit real secrets. Placeholders only.
#
# Validated by: backend/src/config/env.ts
# =============================================================================


# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------

# Required — PostgreSQL connection string (Prisma datasource)
# Source: local Postgres, Docker (see root .env.example DB_* vars), Neon, Supabase, Vercel Postgres
DATABASE_URL=

# Required — secret for signing JWT access and refresh tokens
# Production: minimum 32 characters (openssl rand -base64 48)
# Source: generate locally; store in Vercel env / secrets manager
JWT_SECRET=

# Optional — runtime environment (default: development)
NODE_ENV=development

# Optional — HTTP listen port (default: 3000; ignored on Vercel — see VERCEL)
PORT=3000

# Optional — access token lifetime (default: 7d)
JWT_EXPIRES_IN=7d

# Optional — refresh token lifetime (default: 30d)
JWT_REFRESH_EXPIRES_IN=30d


# -----------------------------------------------------------------------------
# CORS & password reset
# -----------------------------------------------------------------------------

# Optional in dev (default: *), required in production — comma-separated frontend origin(s)
# Source: Vercel frontend deployment URL or custom domain
# Production: must not be * (startup fails)
CORS_ORIGIN=*

# Optional in dev, required in production — frontend URL for reset-email links
# Source: https://pharma-exchange-frontend.vercel.app (or your custom frontend domain)
# Must NOT be the backend API URL
PASSWORD_RESET_URL_BASE=


# -----------------------------------------------------------------------------
# Rate limiting & logging
# -----------------------------------------------------------------------------

# Optional — sliding window in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Optional — max requests per window in non-production (default: 100)
# Production auth/API limits use fixed caps in rateLimit.middleware.ts
RATE_LIMIT_MAX=100

# Optional — pino log level (default: info)
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# Firebase Admin SDK — optional in dev; required for FCM push + file storage
# Source: Firebase Console → Project settings → Service accounts → Generate new private key
# -----------------------------------------------------------------------------

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=


# -----------------------------------------------------------------------------
# Google Gemini — optional AI match enrichment
# Source: Google AI Studio (https://aistudio.google.com) → Get API key
# When unset, matching falls back to rule-based scoring
# -----------------------------------------------------------------------------

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash


# -----------------------------------------------------------------------------
# Email / SMTP — required in production (password reset)
# Source: Gmail → Security → App passwords, or your SMTP provider
# -----------------------------------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=


# -----------------------------------------------------------------------------
# Razorpay — required in production when RAZORPAY_ENABLED=true
# Source: Razorpay Dashboard → Account & Settings → API Keys
#         Razorpay Dashboard → Settings → Webhooks → Secret
# See: docs/BL-02-RAZORPAY.md
# -----------------------------------------------------------------------------

# Optional — enable payment provider (default: false)
RAZORPAY_ENABLED=false

# Required when RAZORPAY_ENABLED=true in production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional — ISO-4217 currency code (default: INR)
RAZORPAY_CURRENCY=INR


# -----------------------------------------------------------------------------
# Docker only (backend/docker-entrypoint.sh) — not used by env.ts
# -----------------------------------------------------------------------------

# Optional — run prisma migrate deploy on container start (default: true)
RUN_MIGRATIONS=true


# -----------------------------------------------------------------------------
# Vercel platform (auto-set — do not add to .env)
# -----------------------------------------------------------------------------

# VERCEL=1 — set automatically on Vercel; server.ts skips local listen when present
