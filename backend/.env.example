DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharma_exchange?schema=public"
JWT_SECRET="change-me-in-production-use-a-long-random-string"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"
PORT=3000
NODE_ENV=development
OTP_EXPIRY_MINUTES=10
# In development, OTP is logged to console instead of sent via SMS
OTP_DEV_MODE=true
