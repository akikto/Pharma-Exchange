DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharma_exchange?schema=public"
JWT_SECRET="change-me-in-production-use-a-long-random-string"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"
PORT=3000
NODE_ENV=development

# Firebase (optional in dev — enables auth, storage, FCM)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Google Gemini (optional — AI match enrichment)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# CORS
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# =============================================================================
# SMS OTP — MSG91 (production provider)
# =============================================================================
# The backend delegates OTP generation, delivery and verification to MSG91.
# There is NO local OTP generation, dev-mode logging, or mock fallback.
#
# Setup:
#   1. Sign up at https://control.msg91.com and obtain a production Auth Key.
#   2. Register and get approval for your Bangladesh Sender ID.
#   3. Create an OTP template containing the OTP placeholder (##OTP##) and
#      copy its Template ID.
#   4. Set MSG91_ENABLED=true in production. When true and NODE_ENV=production,
#      the app will fail fast if AUTH_KEY / SENDER_ID / TEMPLATE_ID are missing.
#
# See docs/BL-01-MSG91.md for the full checklist.

# Enable the MSG91 SMS OTP provider (set to true in production)
MSG91_ENABLED=false
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
MSG91_OTP_LENGTH=6
MSG91_BASE_URL=https://control.msg91.com/api/v5/otp

# OTP expiry (also passed to MSG91). Must be within MSG91 limits (1–10080).
OTP_EXPIRY_MINUTES=10
