DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharma_exchange?schema=public"
JWT_SECRET="change-me-in-production-use-a-long-random-string"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"
PORT=3000
NODE_ENV=development

# Firebase (optional in dev — enables auth, storage, FCM)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Google Gemini (optional — AI match enrichment)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# CORS
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# =============================================================================
# Payments — Razorpay (BL-02)
# =============================================================================
# Backend delegates payment order creation, capture, refund and cancellation
# to Razorpay. No card data ever touches the app — Razorpay Checkout is
# hosted. See docs/BL-02-RAZORPAY.md for setup.

# Enable the Razorpay provider. When true and NODE_ENV=production, the app
# fails fast if KEY_ID / KEY_SECRET / WEBHOOK_SECRET are missing.
RAZORPAY_ENABLED=false

# Dashboard → Account & Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Dashboard → Settings → Webhooks → your webhook's Secret
RAZORPAY_WEBHOOK_SECRET=

# ISO-4217 3-letter currency for orders. Razorpay India accounts use INR.
# For Bangladesh flows via Razorpay International you may use USD.
RAZORPAY_CURRENCY=INR

# =============================================================================
# Email — SMTP (password reset)
# =============================================================================
# Gmail SMTP (or another provider) for password-reset emails.
# Required in production. See docs/ENVIRONMENT-SETUP.md.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Pharma Exchange <noreply@example.com>"

# Required in production: frontend app URL for password-reset links (not the API backend).
PASSWORD_RESET_URL_BASE=https://pharma-exchange-frontend.vercel.app
