# Email OTP (password reset)
EMAIL_OTP_EXPIRY_MINUTES=5
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TOKEN_EXPIRES_IN=15m

# Resend (https://resend.com) — required for password reset emails in production
# Get your API key: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
# Use onboarding@resend.dev for local/testing without a verified domain
# After verifying your domain in Resend, use: Pharma-Exchange <noreply@yourdomain.com>
RESEND_FROM=Pharma-Exchange <onboarding@resend.dev>
