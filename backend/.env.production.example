# Vercel Production Environment Variables (Backend)
#
# Copy each key/value into the Vercel Project → Settings → Environment
# Variables page. Do NOT commit real values.  Every variable listed here
# must be set for a "Production" deployment; the app fails fast at boot if
# a required one is missing (see docs/BL-03-VERCEL-AUDIT.md).

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=production

# ─── Database ──────────────────────────────────────────────────────────────
# Use a pooled connection string for serverless (Neon/Supabase/RDS Proxy):
#   postgresql://USER:PASS@HOST/DB?sslmode=require&pgbouncer=true&connection_limit=1
# The application enforces a postgresql:// scheme.
DATABASE_URL=

# ─── JWT ───────────────────────────────────────────────────────────────────
# Minimum 32 characters in production. Rotate quarterly.
# Recommendation: `openssl rand -base64 48`
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated origins. Do NOT use * in production.
CORS_ORIGIN=https://pharma-exchange-frontend.vercel.app

# ─── Rate limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
LOG_LEVEL=info

# ─── Firebase Admin SDK ────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# One-line format with escaped newlines (\n). The backend un-escapes it.
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# ─── Gemini (optional AI match enrichment) ─────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── MSG91 SMS OTP (BL-01) ─────────────────────────────────────────────────
MSG91_ENABLED=true
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
MSG91_OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
MSG91_BASE_URL=https://control.msg91.com/api/v5/otp

# ─── Razorpay Payments (BL-02) ─────────────────────────────────────────────
RAZORPAY_ENABLED=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
