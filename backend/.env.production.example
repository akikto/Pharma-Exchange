# =============================================================================
# Pharma-Exchange Backend — Production Environment (Example)
# =============================================================================
# Set these in Vercel → backend project → Settings → Environment Variables.
# NEVER commit real values. See backend/.env.example for full documentation.
# =============================================================================

NODE_ENV=production

DATABASE_URL=
JWT_SECRET=

CORS_ORIGIN=https://pharma-exchange-frontend.vercel.app
PASSWORD_RESET_URL_BASE=https://pharma-exchange-frontend.vercel.app

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

RAZORPAY_ENABLED=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
