# =============================================================================
# Pharma-Exchange — Environment Variables (Example)
# =============================================================================
# Copy to `.env` at the repo root for Docker Compose, or use the scoped files:
#   backend/.env.example  → backend/.env   (local API / Prisma)
#   frontend/.env.example → frontend/.env  (Vite dev server)
#
# NEVER commit real passwords, API keys, private keys, tokens, or secrets.
# Placeholders only. See docs/ENVIRONMENT-SETUP.md for production guidance.
# =============================================================================


# =============================================================================
# Backend API (see backend/.env.example for the full list)
# Source: backend/src/config/env.ts
# =============================================================================

# Required — PostgreSQL connection string for Prisma (local Docker, Neon, Supabase, etc.)
DATABASE_URL=

# Required — JWT signing secret (≥32 chars in production; generate: openssl rand -base64 48)
JWT_SECRET=

# Optional — Runtime mode: development | production | test (default: development)
NODE_ENV=development

# Optional — HTTP port for the API (default: 3000)
PORT=3000

# Required in production — comma-separated frontend origin(s); never use * in prod
# Source: Vercel frontend URL or your custom domain
CORS_ORIGIN=

# Required in production — frontend app URL for password-reset links (not the API URL)
PASSWORD_RESET_URL_BASE=

# Optional — access / refresh token lifetimes (defaults: 7d / 30d)
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Optional — rate limiting (defaults: 900000 ms window, 100 max requests in dev)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Optional — log level: error | warn | info | debug (default: info)
LOG_LEVEL=info


# =============================================================================
# Firebase Admin SDK (Backend) — optional in dev, required for FCM push + storage
# Source: Firebase Console → Project settings → Service accounts → Generate key
# =============================================================================

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=


# =============================================================================
# Google Gemini AI — optional (rule-based matching used when unset)
# Source: Google AI Studio → API keys
# =============================================================================

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash


# =============================================================================
# Email / SMTP (password reset) — required in production
# Source: Gmail app password or your SMTP provider
# =============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=


# =============================================================================
# Razorpay payments — required in production when RAZORPAY_ENABLED=true
# Source: Razorpay Dashboard → API Keys + Webhooks (see docs/BL-02-RAZORPAY.md)
# =============================================================================

RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR


# =============================================================================
# Frontend (Vite) — see frontend/.env.example for the full list
# Only VITE_* variables are exposed to the browser bundle (treat as public).
# Source: frontend/src/lib/*.ts, Firebase Console → Web app config
# =============================================================================

# Required — API base path or full URL (dev: /api/v1 via Vite proxy)
VITE_API_BASE_URL=/api/v1

# Optional — legacy alias for VITE_API_BASE_URL (prefer VITE_API_BASE_URL)
VITE_API_URL=

# Optional — Socket.IO origin (empty = same origin as the page)
VITE_SOCKET_URL=

# Optional — Firebase Web SDK (public keys; required for Google sign-in + web push)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — FCM Web Push VAPID key (Firebase Console → Cloud Messaging → Web configuration)
VITE_FIREBASE_VAPID_KEY=


# =============================================================================
# Docker Compose helpers (root docker-compose.yml only)
# Used to build DATABASE_URL and postgres service — not read by the Node app directly
# =============================================================================

DB_USER=
DB_PASSWORD=
DB_NAME=

# Maps to backend CORS_ORIGIN in docker-compose.yml
CORS_ALLOWED_ORIGINS=

# Optional — run Prisma migrations on backend container start (default: true)
RUN_MIGRATIONS=true


# =============================================================================
# Vercel (platform — do not set manually)
# =============================================================================

# Auto-set to "1" on Vercel serverless; used to skip binding a local HTTP port
# VERCEL=


# =============================================================================
# CI / E2E / QA scripts (optional — local and GitHub Actions)
# =============================================================================

# Playwright target URLs (defaults: http://localhost:5173 and http://localhost:3000/api/v1)
PLAYWRIGHT_BASE_URL=
PLAYWRIGHT_API_URL=

# Set to skip Playwright webServer auto-start
PLAYWRIGHT_SKIP_WEBSERVER=

# Used by scripts/medicine-e2e-verification.mjs
API_BASE_URL=

# Used by npm run smoke (defaults: http://localhost:3000)
API_BASE=

# Auto-set by GitHub Actions
# CI=true


# =============================================================================
# TWA / Android APK build (optional — twa/build-apk.mjs, local release only)
# Source: your Android keystore; JDK and Android SDK paths on the build machine
# =============================================================================

BUBBLEWRAP_KEYSTORE_PASSWORD=
BUBBLEWRAP_KEY_PASSWORD=
JDK_PATH=
ANDROID_SDK_ROOT=
