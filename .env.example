# =============================================================================
# MedLink B2B – Pharmacy Exchange Marketplace
# Environment Variables (Example)
# =============================================================================
# Copy this file to `.env` and fill in your values.
# NEVER commit real secrets, API keys, passwords, or tokens to version control.
# =============================================================================


# =============================================================================
# Application
# =============================================================================

# Runtime environment: development | production | test
NODE_ENV=development

# Application display name
APP_NAME=MedLink B2B

# Public frontend URL (used for links, redirects, CORS validation)
APP_URL=http://localhost:5173

# Public backend API URL
API_URL=http://localhost:3000

# HTTP server port for the backend API
PORT=3000


# =============================================================================
# Frontend (Vite)
# =============================================================================
# Vite exposes only variables prefixed with VITE_ to the client bundle.
# Never put server-side secrets in VITE_ variables.

VITE_APP_NAME=MedLink B2B

# Backend API base URL (use /api/v1 with Vite proxy in local dev)
VITE_API_BASE_URL=/api/v1

# Firebase Web SDK configuration (from Firebase Console → Project settings)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Maps JavaScript API key (for pharmacy location features)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key


# =============================================================================
# Backend – Authentication & Sessions
# =============================================================================

# Secret for signing JWT access tokens (minimum 32 random characters)
JWT_SECRET=change-me-use-a-long-random-string-at-least-32-chars

# Access token expiry (e.g. 7d, 24h, 15m)
JWT_EXPIRES_IN=7d

# Secret for signing refresh tokens (use a different value from JWT_SECRET)
REFRESH_TOKEN_SECRET=change-me-use-a-different-long-random-string

# Refresh token expiry
REFRESH_TOKEN_EXPIRES_IN=30d

# Express session secret (if session middleware is enabled)
SESSION_SECRET=change-me-use-another-long-random-string


# =============================================================================
# Firebase (Admin SDK – Backend)
# =============================================================================
# Service account credentials from Firebase Console → Project settings → Service accounts

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com


# =============================================================================
# Database – PostgreSQL (Primary)
# =============================================================================
# MedLink B2B uses PostgreSQL with Prisma ORM for transactional marketplace data.

# Full connection string (preferred — used by Prisma)
DATABASE_URL=postgresql://medlink_user:your_db_password@localhost:5432/medlink_b2b?schema=public

# Individual connection parameters (optional — for Docker / manual setup)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medlink_b2b
DB_USER=medlink_user
DB_PASSWORD=your_db_password


# =============================================================================
# Database – Firestore (Optional / Firebase Ecosystem)
# =============================================================================
# Uncomment if using the Firestore emulator for local development.

# FIRESTORE_EMULATOR_HOST=localhost:8080


# =============================================================================
# Storage
# =============================================================================

# Storage provider: firebase | local | s3
STORAGE_PROVIDER=firebase

# Default storage bucket name
STORAGE_BUCKET=your-project-id.appspot.com


# =============================================================================
# Notifications (Firebase Cloud Messaging)
# =============================================================================

# Legacy FCM server key (prefer Firebase Admin SDK in production)
FCM_SERVER_KEY=your-fcm-server-key

# FCM project ID (usually same as FIREBASE_PROJECT_ID)
FCM_PROJECT_ID=your-project-id


# =============================================================================
# Email (SMTP)
# =============================================================================

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@medlink-b2b.example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="MedLink B2B <noreply@medlink-b2b.example.com>"


# =============================================================================
# SMS / OTP (BL-01 — MSG91)
# =============================================================================
# MedLink B2B delegates OTP delivery/verification to MSG91 in production.
# No local OTP generation, no dev-mode fallback.
#
# See docs/BL-01-MSG91.md for the setup checklist and account requirements.

# Enable the MSG91 provider. When true and NODE_ENV=production, the process
# fails fast if any of AUTH_KEY / SENDER_ID / TEMPLATE_ID are missing.
MSG91_ENABLED=false

# Obtain from Control Panel → API / Integration
MSG91_AUTH_KEY=

# Approved sender ID for Bangladesh (see MSG91 country rules)
MSG91_SENDER_ID=

# OTP template ID (must contain ##OTP## placeholder)
MSG91_TEMPLATE_ID=

# OTP length (MSG91 accepts 4–9)
MSG91_OTP_LENGTH=6

# OTP expiry in minutes (must be within MSG91 limits 1–10080)
OTP_EXPIRY_MINUTES=10

# Override only for staging/testing
MSG91_BASE_URL=https://control.msg91.com/api/v5/otp


# =============================================================================
# Maps
# =============================================================================

# Google Maps API key (server-side geocoding / distance calculations)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key


# =============================================================================
# File Upload
# =============================================================================

# Maximum upload size in megabytes
MAX_UPLOAD_SIZE_MB=10

# Comma-separated list of allowed MIME types
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf


# =============================================================================
# Logging
# =============================================================================

# Log level: error | warn | info | http | debug
LOG_LEVEL=info


# =============================================================================
# Rate Limiting
# =============================================================================

# Rate limit window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window per IP
RATE_LIMIT_MAX_REQUESTS=100


# =============================================================================
# CORS
# =============================================================================

# Comma-separated list of allowed frontend origins (no wildcard in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000


# =============================================================================
# WebSocket
# =============================================================================

# Socket.IO server URL (leave empty to use same origin as API)
WS_URL=


# =============================================================================
# Analytics
# =============================================================================

# Enable platform analytics collection
ANALYTICS_ENABLED=true


# =============================================================================
# Feature Flags
# =============================================================================

ENABLE_CHAT=true
ENABLE_NOTIFICATIONS=true
ENABLE_ANALYTICS=true
ENABLE_REVIEWS=true
ENABLE_PWA=true


# =============================================================================
# Admin
# =============================================================================

# Default admin email for initial seed / bootstrap (development only)
DEFAULT_ADMIN_EMAIL=admin@medlink-b2b.example.com
